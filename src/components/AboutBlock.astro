---
import Arrow from './Arrow.astro';
import { img } from '../lib/img';
---

<section class="wrap section about reveal">
  <div class="grid8 top">
    <div class="text">
      <p class="label small">.about</p>
      <div class="copy h3">
        <p>my thing is making creativity work. not just the beauty, but clear, relevant, and built to drive real impact.</p>
        <p>
          i've spent 8 years at adyen turning complex fintech into work people actually connect with. scaling a team from 5 to 50 taught me that the best results come from high-trust environments, sharp briefs, and people who genuinely enjoy the work.
        </p>
      </div>
    </div>
    <div class="portrait">
      <img
        {...img('/images/site/portrait.jpg', '(min-width: 810px) 38vw, 100vw')}
        alt="Portrait of Bas Brouwers"
        loading="lazy"
        decoding="async"
      />
      <div class="grain" aria-hidden="true"></div>
    </div>
  </div>
  <div class="grid8 actions">
    <a href="/about" class="btn cta">about me <Arrow /></a>
    <span class="marker" style="top:14px"></span>
  </div>
</section>

<style>
  .top {
    align-items: start;
  }
  .text {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 1em;
    color: var(--white);
  }
  .portrait {
    grid-column: 6 / span 3;
    position: relative;
    aspect-ratio: 1408 / 1828;
    overflow: hidden;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .grain {
    position: absolute;
    inset: 0;
    background: url('/images/site/grain.png');
    background-size: 256px 256px;
    opacity: 0.08;
  }
  .actions {
    position: relative;
    margin-top: 48px;
  }
  .cta {
    grid-column: 5 / span 2;
  }
  @media (max-width: 809.98px) {
    .top {
      gap: 40px;
    }
  }
</style>
