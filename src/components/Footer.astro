---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/projects', label: 'projects' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact' },
];
---

<footer class="footer section">
  <div class="wrap inner">
    <a href="https://easyfast.design" class="name">bas brouwers</a>
    <nav class="links" aria-label="Footer">
      {
        links.map((l) => (
          <a href={l.href} class:list={[{ current: path.startsWith(l.href) }]}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="socials">
      <a href="https://www.instagram.com/bastiaanbrouwers/" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/basbrouwers/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
          <path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.7 1-2.6 2.3-2.6s2.2.8 2.2 2.6V16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: 120px;
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    font-size: 18px;
    letter-spacing: -0.4px;
  }
  .name {
    font-size: 20px;
    color: var(--white-50);
  }
  .links {
    display: flex;
    gap: 36px;
  }
  .socials {
    display: flex;
    gap: 24px;
    justify-content: flex-end;
  }
  .links a,
  .socials a,
  .name {
    color: var(--white-50);
    transition: color 0.2s ease;
  }
  .links a:hover,
  .links a.current,
  .socials a:hover,
  .name:hover {
    color: var(--white);
  }
  @media (max-width: 809.98px) {
    .inner {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 32px;
    }
    .socials {
      justify-content: flex-start;
    }
  }
</style>
