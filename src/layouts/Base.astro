---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Replaces the green accent, used on tailored pages */
  accent?: string;
  /** Hide the menu and footer links, for tailored pages */
  bare?: boolean;
}

const {
  title = 'bas brouwers - strategic creative director',
  description = 'a strategic creative director with a thing for making complex things clear, building teams that actually ship, brand, content & AI and the work behind the work',
  image = 'https://bas.plus/images/site/og.jpg',
  noindex = false,
  accent,
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class:list={["no-js", { bare }]} style={accent ? `--green:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      // Visitors from a tailored page (?via=ramp) stay in that context.
      (function () {
        var via = new URLSearchParams(location.search).get('via');
        if (!via || !/^[a-z0-9-]+$/.test(via)) return;
        var root = document.documentElement;
        root.classList.add('bare');
        root.dataset.via = via;
        try {
          var accent = sessionStorage.getItem('via-accent-' + via);
          if (accent && /^#[0-9a-f]{3,8}$/i.test(accent)) root.style.setProperty('--green', accent);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="bg-lines" aria-hidden="true">
      <div class="wrap">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
    {!bare && <Nav />}
    <a class="via-back small" href="/" hidden>&larr; back</a>
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // In tailored context: point the back link home, keep contact on email.
      const root = document.documentElement;
      if (root.classList.contains('bare')) {
        const via = root.dataset.via;
        const back = document.querySelector<HTMLAnchorElement>('.via-back');
        if (via && back) {
          back.href = `/${via}/`;
          back.hidden = false;
        }
        document.querySelectorAll<HTMLAnchorElement>('a[href="/contact"]').forEach((a) => {
          a.href = 'mailto:basbrouwers@me.com';
        });
        if (via) {
          document.querySelectorAll<HTMLAnchorElement>('a[href^="/work/"]').forEach((a) => {
            const u = new URL(a.href);
            u.searchParams.set('via', via);
            a.href = u.pathname + u.search;
          });
        }
      }
    </script>
  </body>
</html>
