---
import Base from '../layouts/Base.astro';

// The Framer page shows these as labels. LinkedIn and Instagram link to the profiles from the footer.
const socials = [
  { label: 'linkedin', handle: '@bastiaanbrouwers', href: 'https://www.linkedin.com/in/basbrouwers/', icon: 'linkedin' },
  { label: 'instagram', handle: '@bastiaanbrouwers', href: 'https://www.instagram.com/bastiaanbrouwers/', icon: 'instagram' },
  { label: 'substack', handle: '@thoughtsbybas', href: '', icon: 'bookmark' },
];
---

<Base title="contact - bas brouwers">
  <section class="wrap head">
    <h1 class="h1 reveal">say hello</h1>
    <span class="marker" style="top:calc(var(--nav-h) + 112px)"></span>
  </section>

  <section class="wrap grid8 body-row">
    <p class="h2 statement reveal">
      feel free to <a href="mailto:basbrouwers@me.com" class="mail">drop me a line</a> or follow me on social networks
    </p>
    <ul class="socials reveal">
      {
        socials.map((s) => {
          const inner = (
            <>
              <span class="icon">
                {s.icon === 'linkedin' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.3" />
                    <path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.7 1-2.6 2.3-2.6s2.2.8 2.2 2.6V16" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                )}
                {s.icon === 'instagram' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.3" />
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.3" />
                    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" />
                  </svg>
                )}
                {s.icon === 'bookmark' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 3h12v18l-6-4.5L6 21V3z" stroke="currentColor" stroke-width="1.3" />
                    <path d="M6 13l6-4.5 6 4.5" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                )}
              </span>
              <span class="txt">
                <span class="lbl">{s.label}</span>
                <span class="small">{s.handle}</span>
              </span>
              <span class="marker" style="top:36px; right:24px" />
            </>
          );
          return (
            <li>
              {s.href ? (
                <a href={s.href} target="_blank" rel="noopener" class="row">
                  {inner}
                </a>
              ) : (
                <div class="row">{inner}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<style>
  .head {
    position: relative;
    padding-top: calc(var(--nav-h) + 24px);
  }
  .head h1 {
    color: var(--white);
  }
  .body-row {
    margin-top: 180px;
    min-height: 55vh;
    align-items: start;
  }
  .statement {
    grid-column: 1 / span 6;
    grid-row: 1;
    color: var(--white);
    padding-right: 120px;
  }
  .mail {
    color: var(--green);
  }
  .mail:hover {
    text-decoration: underline;
  }
  .socials {
    grid-column: 6 / span 3;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0 0 0 90px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 1px solid var(--white-25);
    color: var(--white-50);
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }
  a.row:hover .icon {
    background: var(--white);
    color: var(--black);
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lbl {
    font-size: 20px;
    letter-spacing: -0.4px;
    color: var(--white-50);
  }
  .txt .small {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.3);
  }
  @media (max-width: 1023.98px) {
    .statement {
      grid-column: 1 / span 8;
      padding-right: 0;
    }
    .socials {
      grid-column: 1 / span 8;
      grid-row: 2;
      padding: 64px 0 0;
    }
  }
  @media (max-width: 809.98px) {
    .body-row {
      margin-top: 80px;
    }
  }
</style>
