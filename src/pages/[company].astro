---
/**
 * Tailored pages at bas.plus/[company].
 * Content lives in src/content/tailored/<company>.md.
 * Noindex, out of the sitemap, never linked. No menu: visitors stay on this page
 * and the projects it opens (those carry ?via=<company> and hide the menu too).
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SayHello from '../components/SayHello.astro';
import Arrow from '../components/Arrow.astro';
import { allProjects } from '../lib/projects';

export async function getStaticPaths() {
  const RESERVED = ['projects', 'work', 'about', 'contact', '404'];
  const pages = await getCollection('tailored');
  const projects = await allProjects();
  return pages.map((page) => {
    if (RESERVED.includes(page.id)) throw new Error(`"${page.id}" is a reserved slug`);
    const picks = page.data.projects.map(({ slug, why }) => {
      const project = projects.find((p) => p.id === slug);
      if (!project) throw new Error(`${page.id}: unknown project "${slug}"`);
      if (project.data.visibility === 'private') throw new Error(`${page.id}: "${slug}" is private`);
      return { project, why };
    });
    return { params: { company: page.id }, props: { page, picks } };
  });
}

const { page, picks } = Astro.props;
const { company, role, roleUrl, accent, intro } = page.data;
const paragraphs = intro.split(/\n\s*\n/);
---

<Base title={`bas + ${company.toLowerCase()}`} description={`bas brouwers for ${company}, ${role}`} accent={accent} noindex bare>
  <section class="wrap head">
    <h1 class="title" aria-label={`Bas + ${company}`}>
      <span class="w" style="--d:0"><span>Bas</span></span>
      <span class="w plus" style="--d:1"><span>+</span></span>
      <span class="w co" style="--d:2"><span>{company}</span></span>
    </h1>
    <div class="grid8 sub">
      <p class="small role">
        {roleUrl ? <a href={roleUrl} target="_blank" rel="noopener">{role} <Arrow /></a> : role}
      </p>
    </div>
  </section>

  <section class="wrap intro">
    <div class="grid8">
      <div class="text">
        {paragraphs.map((para, i) => <p class="body reveal" style={`transition-delay:${i * 120}ms`}>{para}</p>)}
      </div>
    </div>
  </section>

  <section class="wrap list">
    <p class="label small draw reveal">.{picks.length} projects</p>
    {
      picks.map(({ project, why }, i) => (
        <div class="grid8 row reveal">
          <div class="card-col">
            <ProjectCard slug={project.id} {...project.data} eager={i === 0} via={page.id} />
          </div>
          <p class="why small">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            {why}
          </p>
          <span class="marker" style="bottom:-12px" />
        </div>
      ))
    }
  </section>

  <SayHello />
</Base>

<script is:inline define:vars={{ via: page.id, accent }}>
  try {
    sessionStorage.setItem('via-accent-' + via, accent);
  } catch (e) {}
</script>

<style>
  .head {
    padding-top: 160px;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.22em;
    font-weight: 500;
    font-size: min(14.5vw, 280px);
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin-left: -0.04em;
  }
  .w {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .w > span {
    display: inline-block;
    transform: translateY(105%);
    animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--d) * 120ms + 150ms);
  }
  .plus > span {
    color: var(--white-50);
    font-weight: 300;
  }
  .co > span {
    color: var(--green);
  }
  @keyframes rise {
    to {
      transform: none;
    }
  }
  .sub {
    margin-top: 32px;
    opacity: 0;
    animation: fade 0.8s ease forwards 0.7s;
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  .role {
    grid-column: 1 / span 4;
  }
  .role a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    transition: color 0.2s ease;
  }
  .role a:hover {
    color: var(--green);
  }
  .role a :global(svg) {
    transition: transform 0.3s ease;
  }
  .role a:hover :global(svg) {
    transform: translate(3px, -3px);
  }
  .intro {
    padding-top: 160px;
    padding-bottom: 160px;
  }
  .text {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    gap: 1.25em;
  }
  .text p {
    color: var(--white);
  }
  /* The rule after the label draws in */
  .draw::after {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s;
  }
  .draw.in::after {
    transform: none;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }
  .row {
    position: relative;
    align-items: start;
  }
  .card-col {
    grid-column: 1 / span 6;
  }
  .why {
    grid-column: 7 / span 2;
    padding: 4px 0 0 24px;
    color: var(--white);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.8s ease 0.4s,
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s;
  }
  .row.in .why {
    opacity: 1;
    transform: none;
  }
  .n {
    display: block;
    margin-bottom: 12px;
    color: var(--green);
  }
  @media (max-width: 1023.98px) {
    .head {
      padding-top: 120px;
    }
    .text {
      grid-column: 1 / span 8;
    }
    .list {
      gap: 64px;
    }
    .intro {
      padding-top: 96px;
      padding-bottom: 96px;
    }
  }
  @media (max-width: 809.98px) {
    .head {
      padding-top: 96px;
    }
    .title {
      font-size: 22vw;
    }
    .role {
      grid-column: 1 / -1;
    }
    .card-col,
    .why {
      grid-column: 1 / -1;
    }
    .why {
      padding: 16px 0 0;
    }
    .list {
      gap: 48px;
    }
    .intro {
      padding-top: 64px;
      padding-bottom: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w > span,
    .sub {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .draw::after,
    .why {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
  :global(.no-js) .why,
  :global(.no-js) .draw::after {
    opacity: 1;
    transform: none;
  }
</style>
